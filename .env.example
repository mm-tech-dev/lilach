# All of these are server-side only. Never prefix any of them with NEXT_PUBLIC_.
# Locally: copy to .env.local and fill in. In production they are set in
# Vision OS -> project -> deploy settings (buildConfig.env), not from git.

# --- Vision OS CMS ---
VISION_OS_API_URL=https://morevision.co.il/api
VISION_OS_API_KEY=vos_your_key_here
VISION_OS_PROJECT_ID=your_project_id_here

# --- Email notifications (SMTP) ---
# Leave SMTP_HOST empty to disable direct sending; the site then falls back to
# the Vision OS project mailer. Sending is also retried through Vision OS if an
# SMTP send fails, so a form submission is never lost.
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_USER="smtp@example.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="Sender Name <smtp@example.com>"
# SMTP_SECURE: "true" for implicit TLS (port 465), "false" for STARTTLS (587).
# Omit it and the port decides.
SMTP_SECURE="false"

# --- Where form submissions are emailed ---
# Both are used; duplicates are collapsed into a single recipient.
ADMIN_NOTIFY_EMAIL="admin@example.com"
CONTACT_EMAIL="contact@example.com"
